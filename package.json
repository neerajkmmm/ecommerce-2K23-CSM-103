{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Sprint 2 catalog data foundation API for the E-Commerce SDLC project.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/migrate.js",
    "seed": "node seeds/seed.js",
    "db:test:reset": "NODE_ENV=test node migrations/reset.js && NODE_ENV=test node migrations/migrate.js",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
